VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Salin file ini menjadi ".env" (bukan ".env.example") di root project,
# lalu isi dengan nilai asli dari Supabase Dashboard > Project Settings > API.
